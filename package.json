{
  "name": "playwright-test-automation-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright Test Automation Platform \u2014 npm-workspaces monorepo (UI + API core; opt-in plugins)",
  "author": "CaslanQA",
  "license": "MIT",
  "engines": {
    "node": ">=22.23"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "changeset": "changeset",
    "clean": "node scripts/clean.mjs",
    "commit": "cz",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,json,md,yml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pack:platform": "npm pack packages/core-template",
    "prepare": "husky",
    "release": "changeset publish",
    "nfr": "node scripts/nfr-check.mjs",
    "test:device": "node --import ./scripts/test-hooks.mjs --test-timeout=600000 --test-concurrency=1 --test \"packages/mobile-inspector/test/inspector.device.test.ts\" \"packages/mobile-inspector/test/mcp.device.test.ts\"",
    "smoke": "node scripts/smoke-scaffold.mjs",
    "smoke:judge": "node scripts/smoke-judge.mjs",
    "smoke:k6": "node scripts/smoke-k6.mjs",
    "test": "node --import ./scripts/test-hooks.mjs --test-timeout=30000 --test \"packages/*/test/**/*.test.ts\"",
    "typecheck:perf-templates": "tsc -p packages/plugin-perf/templates/perf/tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:ui": "npm run typecheck:ui --workspace=@pwtap/mobile-inspector",
    "version-packages": "changeset version",
    "smoke:agents": "node scripts/smoke-agents.mjs",
    "smoke:heal": "node scripts/smoke-heal.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "allure-playwright": "^3.10.1",
    "better-sqlite3": "^13.0.2",
    "commitizen": "^4.3.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
