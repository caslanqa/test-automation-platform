{
  "name": "@pwtap/plugin-appium",
  "version": "1.0.0",
  "description": "Mobile testing for Playwright via Appium \u2014 a raw WebdriverIO session (app: WebdriverIO.Browser) over Android + iOS simulator, macOS-first",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caslanqa/test-automation-platform.git",
    "directory": "packages/plugin-appium"
  },
  "engines": {
    "node": ">=22.23"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./ensure": {
      "types": "./dist/ensure.d.ts",
      "default": "./dist/ensure.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "default": "./dist/inspector.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.61.0"
  },
  "dependencies": {
    "@pwtap/mobile-core": "^1.0.0",
    "@pwtap/platform": "^1.0.0",
    "fast-xml-parser": "^5.0.0",
    "webdriverio": "^9"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/clean.mjs . && npm run build"
  }
}
