{
  "name": "@pwtap/plugin-perf",
  "version": "0.1.1",
  "description": "Performance testing for Playwright — Core Web Vitals, resource budgets and single-endpoint latency benchmarks, asserted inside the suite you already have",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caslanqa/test-automation-platform.git",
    "directory": "packages/plugin-perf"
  },
  "engines": {
    "node": ">=22.23"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./ensure": {
      "types": "./dist/ensure.d.ts",
      "default": "./dist/ensure.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.61.0"
  },
  "dependencies": {
    "autocannon": "^8.0.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/k6": "^2.0.1"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/clean.mjs . && npm run build"
  }
}
