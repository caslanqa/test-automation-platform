{
  "name": "@pwtap/mobile-inspector",
  "version": "1.0.0",
  "description": "Mobile test recorder for the Playwright Test Automation Platform \u2014 local service, browser UI and code generator. A dev tool: the runtime contracts live in @pwtap/mobile-core",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caslanqa/test-automation-platform.git",
    "directory": "packages/mobile-inspector"
  },
  "engines": {
    "node": ">=22.23"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ui-dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mobile-inspect": "./bin/inspect.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.61.0"
  },
  "dependencies": {
    "@pwtap/mobile-core": "^1.0.0",
    "@pwtap/platform": "^1.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "build:ui": "vite build",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "prepack": "node ../../scripts/clean.mjs . && npm run build && npm run build:ui"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "codemirror": "^6.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^6.4.3",
    "prettier": "^3.9.6"
  }
}
