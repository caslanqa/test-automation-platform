{
  "name": "@pwtap/mobile-core",
  "version": "1.2.0",
  "description": "Driver-neutral mobile contracts for the Playwright Test Automation Platform — the action IR, locator engine, device discovery, driver-adapter registry and the mobileApp test fixture",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caslanqa/test-automation-platform.git",
    "directory": "packages/mobile-core"
  },
  "engines": {
    "node": ">=22.23"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.61.0"
  },
  "dependencies": {
    "@pwtap/platform": "^1.1.0"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/clean.mjs . && npm run build"
  }
}
