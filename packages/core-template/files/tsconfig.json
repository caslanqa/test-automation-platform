{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "types": ["node", "@playwright/test"],
    "noEmit": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@api/*": ["api/*"],
      "@pages/*": ["pages/*"],
      "@config/*": ["config/*"],
      "@utils/*": ["utils/*"],
      "@fixtures": ["fixtures/index.ts"],
      "@fixtures/*": ["fixtures/*"],
      "@tests/*": ["tests/*"],
      "@env/*": ["env/*"],
      "@testData/*": ["testData/*"]
    }
  },
  "include": ["**/*.ts"],
  // `perf` is excluded because k6 load scripts live there and belong to a different runtime: they import `k6/http`
  // and use the `open()`/`__ENV` globals, none of which exist here, and they name imports with an explicit `.ts`
  // extension because that is what k6's own resolver needs. They are type-checked by their own project instead —
  // `npm run typecheck:perf`, which @pwtap/plugin-perf adds. Harmless when the directory does not exist.
  "exclude": ["node_modules", "dist", "playwright-report", "test-results", "allure-results", "perf"]
}
